# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Provide your Supabase project URL and public Anon key.
# When provided, the platform seamlessly connects to your live Supabase database,
# Auth, Storage, and Realtime services.
# A robust embedded Supabase-compatible local/fallback persistence engine with automatic schema bootstrapping
# is also provided so the platform works out of the box with zero setup while connecting instantly to real Supabase when keys are added.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key-here"
